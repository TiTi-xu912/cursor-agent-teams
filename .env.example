# Use this instead of `cursor-agent-teams login` for unattended runs.
CURSOR_API_KEY=

# `auto` lets Cursor choose from models available to the authenticated account.
CURSOR_MODEL=auto

CURSOR_AGENT_TEAMS_MAX_MEMBERS=8
CURSOR_AGENT_TEAMS_MAX_REPAIR_ROUNDS=2
CURSOR_AGENT_TEAMS_DASHBOARD_HOST=127.0.0.1
CURSOR_AGENT_TEAMS_DASHBOARD_PORT=43117

# Keep ambient user settings disabled by default for deterministic automation.
CURSOR_AGENT_TEAMS_LOAD_SETTINGS=0
CURSOR_AGENT_TEAMS_ALLOW_NESTED=0
