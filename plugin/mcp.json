{
  "mcpServers": {
    "cursor-agent-teams": {
      "type": "stdio",
      "command": "cursor-agent-teams",
      "args": [
        "mcp",
        "--workspace",
        "${workspaceFolder}"
      ],
      "env": {
        "CURSOR_MODEL": "auto",
        "CURSOR_AGENT_TEAMS_DASHBOARD_PORT": "43117"
      },
      "envFile": "${workspaceFolder}/.env"
    }
  }
}
